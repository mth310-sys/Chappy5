; Engine configuration file.
; Slot Pachiro Godot test project inside Chappy5.
; Generated for Godot 4.x.

config_version=5

[application]
config/name="Slot Pachiro Godot Lab"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

audio/driver/enable_input=false
