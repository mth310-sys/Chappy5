var _textures: Array[ImageTexture] = []
var _frame_index := 0
var _elapsed := 0.0
var _moving := true
var _flip_h := false

func _ready() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_build_textures()
	queue_redraw()

func set_motion(motion: Vector2) -> void:
	_moving = motion.length_squared() > 0.0001
	if abs(motion.x) > 0.01:
		_flip_h = motion.x < 0.0

func _process(delta: float) -> void:
	if _textures.is_empty():
		return
	if _moving:
		_elapsed += delta
		if _elapsed >= FRAME_TIME:
			_elapsed -= FRAME_TIME
			_frame_index = 1 + ((_frame_index) % 4)
			queue_redraw()
	elif _frame_index != 0:
		_frame_index = 0
		queue_redraw()

func _build_textures() -> void:
	for frame_rows in FRAMES:
		var image := Image.create(FRAME_SIZE, FRAME_SIZE, false, Image.FORMAT_RGBA8)
		for y in range(FRAME_SIZE):
			var row: String = frame_rows[y]
			for x in range(FRAME_SIZE):
				var palette_index := _hex_index(row.substr(x, 1))
				image.set_pixel(x, y, PALETTE[palette_index])
		var texture := ImageTexture.create_from_image(image)
		_textures.append(texture)

func _hex_index(value: String) -> int:
	var code := value.unicode_at(0)
	if code >= 48 and code <= 57:
		return code - 48
	return code - 55

func _draw() -> void:
	if _textures.is_empty():
		return
	var texture := _textures[_frame_index]
	var destination := Rect2(-24, -48, 48, 48)
	if _flip_h:
		destination.position.x = 24
		destination.size.x = -48
	draw_texture_rect(texture, destination, false)
